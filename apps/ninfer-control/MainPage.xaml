<Page
    x:Class="NInferControl.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="HelperStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{ThemeResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource InputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}" />
        <Style x:Key="MonoTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{ThemeResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource InputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
        </Style>
    </Page.Resources>

    <NavigationView x:Name="MainNavigation" PaneTitle="NInfer Control"
                    IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                    SelectionChanged="NavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="ServerNavItem" Content="Servidor" Tag="server" Icon="World" IsSelected="True" />
            <NavigationViewItem x:Name="AdvancedNavItem" Content="Configurações avançadas" Tag="advanced" Icon="Setting" />
            <NavigationViewItem x:Name="LogsNavItem" Content="Logs" Tag="logs" Icon="Document" />
        </NavigationView.MenuItems>

        <Grid Padding="32,28,32,24">
            <Grid x:Name="ServerView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Servidor" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource PrimaryTextBrush}" />
                        <TextBlock Text="Escolha o modelo, defina o endpoint e inicie a inferência."
                                   FontSize="15" Foreground="{ThemeResource MutedTextBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="StatusBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="{ThemeResource SurfaceElevatedBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                            BorderThickness="1" CornerRadius="18" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Parado" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="ServerLayout" Grid.Row="1" ColumnSpacing="16" MinHeight="0" SizeChanged="ServerLayout_SizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ServerLeftColumn" Width="1.15*" />
                        <ColumnDefinition x:Name="ServerRightColumn" Width="1*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="ServerFormPane" Grid.Row="0" Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Modelo" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Selecione o artefato .ninfer que será carregado na GPU."
                                               Style="{StaticResource HelperStyle}" Margin="0,0,0,16" />
                                    <TextBlock Text="Arquivo do modelo" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="ModelPathBox" PlaceholderText="C:\modelos\qwen3_8_27b_nvfp4.ninfer" AutomationProperties.Name="Arquivo do modelo" />
                                        <Button Grid.Column="1" Click="BrowseModel_Click" ToolTipService.ToolTip="Selecionar arquivo .ninfer">
                                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /><TextBlock Text="Selecionar" /></StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="ModelHint" Text="Obrigatório. O caminho é salvo automaticamente." Style="{StaticResource HelperStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Servidor HTTP" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Defina onde a API OpenAI/Anthropic ficará disponível." Style="{StaticResource HelperStyle}" Margin="0,0,0,16" />
                                    <Grid ColumnSpacing="16" RowSpacing="14">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="Host" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="HostBox" Text="0.0.0.0" AutomationProperties.Name="Host" /></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Porta" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="PortBox" Text="8088" AutomationProperties.Name="Porta" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Concorrência" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="ConcurrencyBox" Text="1" AutomationProperties.Name="Concorrência máxima" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Intervalo de estatísticas (ms)" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="StatsIntervalBox" Text="1500" AutomationProperties.Name="Intervalo de estatísticas" /></StackPanel>
                                    </Grid>
                                    <TextBlock Text="Host 0.0.0.0 aceita conexões na rede local; use 127.0.0.1 para acesso somente neste PC." Style="{StaticResource HelperStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="ServerCommandPane" Grid.Row="0" Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Backend" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Executável usado pelo app" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="ServerPathBox" IsReadOnly="True" AutomationProperties.Name="Executável ninfer-serve" />
                                        <Button Grid.Column="1" Click="BrowseServer_Click" ToolTipService.ToolTip="Selecionar executável ninfer-serve.exe"><FontIcon Glyph="&#xE712;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></Button>
                                    </Grid>
                                    <TextBlock x:Name="ServerHint" Text="Detectado automaticamente ao lado do build do NInfer." Style="{StaticResource HelperStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Comando gerado" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Confira os argumentos antes de iniciar o processo." Style="{StaticResource HelperStyle}" Margin="0,0,0,12" />
                                    <TextBox x:Name="CommandPreview" Style="{StaticResource MonoTextBoxStyle}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="164" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Comando gerado" />
                                    <Button Content="Copiar comando" Click="CopyCommand_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Operação" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="StatusDetail" Text="Escolha um modelo e inicie o servidor." Style="{StaticResource HelperStyle}" Margin="0" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="StartButton" Click="Start_Click" Style="{StaticResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /><TextBlock Text="Iniciar servidor" /></StackPanel></Button>
                                        <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /><TextBlock Text="Parar" /></StackPanel></Button>
                                        <Button x:Name="OpenBrowserButton" Content="Abrir API" Click="OpenBrowser_Click" IsEnabled="False" />
                                    </StackPanel>
                                    <Button Content="Ver logs" Click="ShowLogs_Click" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="AdvancedView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="960" HorizontalAlignment="Left">
                        <TextBlock Text="Configurações avançadas" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource PrimaryTextBrush}" />
                        <TextBlock Text="Ajuste memória, cache e execução especulativa. As alterações são salvas automaticamente." FontSize="15" Foreground="{ThemeResource MutedTextBrush}" Margin="0,6,0,24" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Memória e contexto" Style="{StaticResource SectionTitleStyle}" />
                                <Grid ColumnSpacing="16" RowSpacing="14" Margin="0,14,0,0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Contexto máximo" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="MaxContextBox" Text="210000" AutomationProperties.Name="Contexto máximo" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Tokens padrão" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="DefaultTokensBox" Text="80000" AutomationProperties.Name="Tokens máximos padrão" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Tipo do KV cache" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="KvDtypeBox" SelectedIndex="1" AutomationProperties.Name="Tipo do KV cache"><ComboBoxItem Content="BF16" Tag="bf16" /><ComboBoxItem Content="INT8" Tag="int8" /></ComboBox></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Capacidade do KV" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="KvCapacityBox" Text="210000" AutomationProperties.Name="Capacidade do KV" /></StackPanel>
                                    <CheckBox x:Name="KvAutoBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" Click="KvAuto_Click"><TextBlock Text="Calcular capacidade automaticamente" TextWrapping="Wrap" /></CheckBox>
                                </Grid>
                                <TextBlock Text="A capacidade explícita precisa ser igual ou maior que o contexto máximo." Style="{StaticResource HelperStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Execução" Style="{StaticResource SectionTitleStyle}" />
                                <Grid ColumnSpacing="16" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Backend especulativo" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="SpecBox" SelectedIndex="1" SelectionChanged="Spec_SelectionChanged" AutomationProperties.Name="Backend especulativo"><ComboBoxItem Content="Desativado" Tag="off" /><ComboBoxItem Content="MTP" Tag="mtp" /><ComboBoxItem Content="DFlash (35B-A3B)" Tag="dflash" /></ComboBox></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Draft tokens" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="DraftTokensBox" Text="3" AutomationProperties.Name="Draft tokens" /></StackPanel>
                                </Grid>
                                <StackPanel Spacing="8" Margin="0,16,0,0">
                                    <CheckBox x:Name="LmHeadDraftBox" Content="Usar LM head otimizado para draft" IsChecked="True" />
                                    <CheckBox x:Name="VisionBox" Content="Ativar Vision para imagem e vídeo" />
                                    <CheckBox x:Name="NoThinkingBox" Content="Desativar modo thinking padrão" />
                                    <CheckBox x:Name="PreserveThinkingBox" Content="Preservar thinking entre turnos" />
                                    <CheckBox x:Name="CorsBox" Content="Permitir CORS para clientes web" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="LogsView" Visibility="Collapsed" MinHeight="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Logs do servidor" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock Text="stdout e stderr em tempo real. Esta tela ocupa toda a área de trabalho." FontSize="15" Foreground="{ThemeResource MutedTextBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Margin="0,16,0,16">
                    <AppBarButton Label="Abrir em outra janela" Icon="OpenFile" Click="OpenLogWindow_Click" />
                    <AppBarButton Label="Limpar" Icon="Clear" Click="ClearLog_Click" />
                </CommandBar>
                <TextBox x:Name="LogTextBox" Grid.Row="2" Style="{StaticResource MonoTextBoxStyle}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Background="{ThemeResource TerminalBrush}" Foreground="{ThemeResource TerminalTextBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Log do servidor" />
            </Grid>
        </Grid>
    </NavigationView>
</Page>
