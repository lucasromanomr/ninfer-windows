<Window
    x:Class="NInferControl.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NInfer Control — Log">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="NInfer Control — Log" />

        <Grid Grid.Row="1" Background="{ThemeResource AppBackgroundBrush}" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Log do servidor" FontSize="24" FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock Text="stdout + stderr • acompanha a execução em tempo real"
                               Foreground="{ThemeResource MutedTextBrush}" FontSize="13" />
                </StackPanel>
                <Button x:Name="ClearButton" Content="Limpar visualização" Click="ClearButton_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Cascadia Mono" FontSize="12"
                     Background="{ThemeResource TerminalBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Log do servidor" />
        </Grid>
    </Grid>
</Window>
