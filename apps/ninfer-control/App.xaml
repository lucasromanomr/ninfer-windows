<Application
    x:Class="NInferControl.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NInferControl">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The app draws its surfaces, text and accents from the Fluent theme resources, so it
                 follows the user's accent colour, light/dark choice and high contrast automatically.
                 Only these few semantic aliases are declared, and the status brushes are looked up by
                 key from code in SetStatus. The terminal keeps a fixed dark ground in every theme,
                 the way console surfaces do, except under high contrast. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="AccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="DangerBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <StaticResource x:Key="MutedTextBrush" ResourceKey="TextFillColorTertiaryBrush" />
                    <SolidColorBrush x:Key="TerminalBrush" Color="#0A0F13" />
                    <SolidColorBrush x:Key="TerminalTextBrush" Color="#D7E6E7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="AccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="DangerBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <StaticResource x:Key="MutedTextBrush" ResourceKey="TextFillColorTertiaryBrush" />
                    <SolidColorBrush x:Key="TerminalBrush" Color="#10191D" />
                    <SolidColorBrush x:Key="TerminalTextBrush" Color="#E4F0F0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="AccentBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="DangerBrush" ResourceKey="SystemColorHotlightColorBrush" />
                    <StaticResource x:Key="MutedTextBrush" ResourceKey="SystemColorGrayTextColorBrush" />
                    <StaticResource x:Key="TerminalBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="TerminalTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
